# MORPHA Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# .env is gitignored - never commit real credentials.
#
# Google Drive is OPTIONAL. Without these values the ritual runs fully and
# saved artifacts fall back to a local download. The key that was previously
# committed to this repository is expired and has been removed - generate your
# own and restrict it to your domain.

# Google Cloud Console: https://console.cloud.google.com/
# 1. Enable the Google Drive API for your project
# 2. Create an OAuth client ID of type "Web application"
# 3. Add your origin to "Authorized JavaScript origins"
#    (http://localhost:5173 for local development)
# 4. Create an API key and restrict it to your domain
VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-api-key-here

# App Configuration
VITE_APP_NAME=MORPHA
VITE_APP_VERSION=0.1.0

# Storage Configuration
VITE_DRIVE_FOLDER_NAME=MORPHA Rituals
